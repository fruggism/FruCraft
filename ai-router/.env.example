# Copia questo file in .env e incolla le chiavi che hai.
# Ne basta una: i fornitori senza chiave vengono saltati.
# Il file .env resta sul tuo computer (è escluso da git).

# --- Gratuiti (piano free: niente addebiti, al massimo un limite di richieste)
GEMINI_API_KEY=
GROQ_API_KEY=
OPENROUTER_API_KEY=
MISTRAL_API_KEY=

# Ollama, se lo hai installato sul PC (modelli locali, gratis e offline)
# OLLAMA_URL=http://localhost:11434/v1

# --- A pagamento (a consumo: usati solo come riserva, dopo i gratuiti)
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# --- Opzioni
# SOLO_GRATIS=1          # parte con «Solo gratis» attivo
# CLASSIFICATORE=regole  # decide con parole chiave invece che con un modello
# PORT=8787
